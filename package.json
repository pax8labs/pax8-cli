{
  "name": "pax8-cli-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Pax8 open source CLI for MSPs to manage cloud marketplace operations",
  "repository": {
    "type": "git",
    "url": "https://github.com/pax8labs/pax8-cli.git"
  },
  "homepage": "https://github.com/pax8labs/pax8-cli#readme",
  "bugs": "https://github.com/pax8labs/pax8-cli/issues",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src/**/*.ts",
    "format": "prettier --write .",
    "dev": "pnpm --filter @pax8/cli dev",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.5",
      "picomatch": "^4.0.4",
      "brace-expansion": "^5.0.6",
      "yaml": "^2.8.3"
    }
  }
}
