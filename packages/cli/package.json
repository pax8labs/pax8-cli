{
  "name": "@pax8/cli",
  "version": "0.2.0",
  "description": "Pax8 open source CLI for MSPs to manage cloud marketplace operations",
  "type": "module",
  "bin": {
    "pax8": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "scripts/check-prerequisites.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "preinstall": "node ./scripts/check-prerequisites.js",
    "build": "tsup",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@pax8/core": "workspace:*",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "ora": "^8.1.0",
    "prompts": "^2.4.2",
    "update-notifier": "^7.3.1",
    "yaml": "^2.9.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pax8labs/pax8-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/pax8labs/pax8-cli#readme",
  "bugs": "https://github.com/pax8labs/pax8-cli/issues",
  "keywords": [
    "pax8",
    "msp",
    "cli",
    "cloud-marketplace",
    "subscriptions",
    "billing"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
