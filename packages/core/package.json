{
  "name": "@pax8/core",
  "version": "0.1.0",
  "description": "Core API client, auth, services, and types for Pax8",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm --dts --watch --sourcemap"
  },
  "dependencies": {
    "posthog-node": "^5.33.3",
    "yaml": "^2.8.4",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pax8labs/pax8-cli.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pax8labs/pax8-cli#readme",
  "bugs": "https://github.com/pax8labs/pax8-cli/issues",
  "keywords": [
    "pax8",
    "msp",
    "cli",
    "cloud-marketplace",
    "subscriptions",
    "billing"
  ],
  "license": "Apache-2.0"
}
