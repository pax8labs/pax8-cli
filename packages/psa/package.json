{
  "name": "@pax8/psa",
  "version": "0.1.0",
  "description": "Read-only PSA reconciliation helpers for Pax8 CLI",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
